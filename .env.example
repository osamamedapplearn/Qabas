# ── Qabas environment template ─────────────────────────────────
# Copy to .env.local for LOCAL dashboard use (never commit .env.local).
# Cloud variables below go in Vercel → Project → Settings → Environment Variables.

# ---- Local dashboard (your PC only) ----
# Enables /admin when running `npm run admin`:
# VITE_ENABLE_ADMIN=true
# Local passcode (localhost only, keep private):
# VITE_ADMIN_PIN=change-me-to-something-private

# ---- Cloud dashboard (Vercel production) ----
# Obscure admin URL path — e.g. https://your-site.vercel.app/admin45678
# Use a long random string. Anyone without it can't even find the login page.
# VITE_ADMIN_PATH=admin8f3k29x7q
# Switches the dashboard to server-authenticated cloud mode:
# VITE_CLOUD_ADMIN=true

# ---- Cloud API secrets (Vercel env vars, NEVER in code) ----
# Strong server password (20+ random chars). Checked server-side on every login.
# ADMIN_PASSWORD=
# Random session-signing secret (different from the password):
# ADMIN_SESSION_SECRET=
# GitHub fine-grained personal access token: repository access → Contents: read+write
# on ONLY this repo. Used by /api/admin/* to commit content edits.
# GITHUB_TOKEN=
# "owner/repo", defaults to osamamedapplearn/Qabas:
# GIT_REPO=osamamedapplearn/Qabas
